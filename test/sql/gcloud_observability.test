# name: test/sql/gcloud_observability.test
# description: test the gcloud_observability extension (offline: load, secret, registration, error paths)
# group: [sql]

# Before the extension is loaded the table function does not exist.
statement error
SELECT * FROM read_gcloud_logs(project => 'my-project');
----
does not exist

require gcloud_observability

# The reader is registered.
query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_gcloud_logs';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'read_gcloud_service_dependencies';
----
true

query I
SELECT count(*) >= 1 FROM duckdb_functions() WHERE function_name = 'send_gcloud_logs';
----
true

# The custom secret type works with Application Default Credentials (no token, no key file).
statement ok
CREATE SECRET gcloud_adc (
    TYPE gcloud,
    PROJECT 'my-project'
);

query I
SELECT type FROM duckdb_secrets() WHERE name = 'gcloud_adc';
----
gcloud

# It also works with an explicit access token.
statement ok
CREATE SECRET gcloud_token (
    TYPE gcloud,
    PROJECT 'my-project',
    TOKEN 'SECRET_TOKEN_VALUE'
);

# ...and with a service-account key file.
statement ok
CREATE SECRET gcloud_key (
    TYPE gcloud,
    PROJECT 'my-project',
    CREDENTIALS '/path/to/service-account.json',
    QUOTA_PROJECT 'billing-project'
);

# TOKEN is redacted, never shown in duckdb_secrets().
query I
SELECT secret_string NOT LIKE '%SECRET_TOKEN_VALUE%' FROM duckdb_secrets() WHERE name = 'gcloud_token';
----
true

# CREDENTIALS is only a path, so it stays visible: knowing which key file is in use leaks nothing.
query I
SELECT secret_string LIKE '%/path/to/service-account.json%' FROM duckdb_secrets() WHERE name = 'gcloud_key';
----
true

# The sender mirrors the Datadog scalar contract: an OTLP-shaped row STRUCT, optional constant
# secret name, VARCHAR result, and unknown fields ignored. Binding never mints a token or writes.
query I
SELECT column_type = 'VARCHAR'
FROM (DESCRIBE SELECT send_gcloud_logs({'body': 'hi', 'service_name': 'checkout', 'unknown_extra': 1},
                                      'gcloud_adc'));
----
true

# A NULL struct is NULL/no-op, so this execution remains fully offline.
query I
SELECT send_gcloud_logs(NULL::STRUCT(body VARCHAR), 'gcloud_adc') IS NULL;
----
true

statement error
DESCRIBE SELECT send_gcloud_logs('not a struct', 'gcloud_adc');
----
first argument must be a STRUCT

statement error
DESCRIBE SELECT send_gcloud_logs({'body': 'hi'}, 'no_such_secret');
----
No secret with name 'no_such_secret' found

statement error
DESCRIBE SELECT send_gcloud_logs({'body': 'hi'}, secret_name)
FROM (VALUES ('gcloud_adc')) secrets(secret_name);
----
secret name must be a constant string

# Referencing a secret that does not exist fails at bind time.
statement error
SELECT * FROM read_gcloud_logs(secret => 'no_such_secret', project => 'my-project');
----
No secret with name 'no_such_secret' found

# Binding succeeds and exposes the OTLP-conformant schema. Every query below passes an explicit
# `project`, so nothing here depends on whether the host has Application Default Credentials
# configured; and binding never calls the network (the token is minted lazily, on the first scan).
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_logs(project => 'my-project'));
----
18

# Key OTLP columns are present (order-independent).
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_logs(project => 'my-project'))
WHERE column_name IN ('time_unix_nano', 'observed_time_unix_nano', 'trace_id', 'span_id', 'severity_number',
                      'severity_text', 'body', 'resource_attributes', 'log_attributes', 'flags');
----
10

# A secret supplies the project when the parameter is omitted.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_logs(secret => 'gcloud_adc'));
----
18

# `resource_names` addresses non-project parents (folders, organizations, log views).
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_logs(resource_names => ['folders/123', 'projects/p']));
----
18

# Named parameters are validated at bind time (no network call is needed to hit these errors).
statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', max_rows => -1);
----
max_rows must be >= 0

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', retries => -1);
----
retries must be >= 0

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', timeout => 0);
----
timeout must be >= 1

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', page_size => 0);
----
page_size must be between 1 and 1000

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', page_size => 1001);
----
page_size must be between 1 and 1000

# entries.list accepts only these two orderings; anything else is rejected rather than silently
# sorted the wrong way.
statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', order_by => 'severity desc');
----
order_by must be 'timestamp desc' or 'timestamp asc'

statement ok
SELECT * FROM (DESCRIBE SELECT * FROM read_gcloud_logs(project => 'my-project', order_by => 'timestamp asc'));

# Time bounds accept relative offsets and RFC 3339 instants, and reject anything else.
statement ok
SELECT * FROM (DESCRIBE SELECT * FROM read_gcloud_logs(project => 'my-project', start_time => '-15m', end_time => 'now'));

statement ok
SELECT * FROM (DESCRIBE SELECT * FROM read_gcloud_logs(project => 'my-project', start_time => '2026-07-09T00:00:00Z'));

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', start_time => '-15x');
----
not a valid relative offset

statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', end_time => 'yesterday');
----
neither a relative offset

# Unknown named parameters are rejected.
statement error
SELECT * FROM read_gcloud_logs(project => 'my-project', bogus_param => 10);
----
Invalid named parameter

# App Topology binding is offline and exposes the canonical cross-provider service-edge schema.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_service_dependencies(project => 'my-project'));
----
17

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_gcloud_service_dependencies(project => 'my-project'))
WHERE column_name IN ('provider', 'source_service', 'target_service', 'source_type', 'target_type', 'edge_type',
                      'environment', 'window_start', 'window_end', 'request_count', 'error_count', 'fault_count',
                      'throttle_count', 'total_response_time_seconds', 'source_attributes', 'target_attributes',
                      'edge_attributes');
----
17

statement error
SELECT * FROM read_gcloud_service_dependencies(project => 'my-project', retries => -1);
----
retries must be between 0 and 100

statement error
SELECT * FROM read_gcloud_service_dependencies(project => 'my-project', timeout => 0);
----
timeout must be >= 1 second

statement error
SELECT * FROM read_gcloud_service_dependencies(project => 'my-project', max_rows => -1);
----
max_rows must be >= 0

# ---------------------------------------------------------------------------
# Conservative WHERE pushdown
# ---------------------------------------------------------------------------
# Planning is offline: pushdown_complex_filter runs during optimization and no token is minted
# until the first scan, so EXPLAIN shows the outgoing filter without touching the network.
# FORMAT JSON avoids the box renderer, which would wrap long filters across lines.

# severity_text equality reaches the API as a `severity` term.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p') WHERE severity_text = 'ERROR';
----
physical_plan	<REGEX>:.*severity = ..ERROR.*

# An IN list becomes a parenthesized OR so the surrounding AND-chain is not broken.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p')
WHERE severity_text IN ('ERROR', 'CRITICAL');
----
physical_plan	<REGEX>:.*severity = ..ERROR.. OR severity = ..CRITICAL.*

# Severity comparison is by enum name, so a lowercase constant still pushes the uppercase member;
# DuckDB's own case-sensitive filter stays above the scan and decides the final rows.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p') WHERE severity_text = 'error';
----
physical_plan	<REGEX>:.*severity = ..ERROR.*

# The optimizer folds `>= AND <=` into a BETWEEN, which must still push both bounds.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p')
WHERE time_unix_nano >= TIMESTAMP_NS '2026-07-20 10:00:00'
  AND time_unix_nano <= TIMESTAMP_NS '2026-07-21 10:00:00';
----
physical_plan	<REGEX>:.*timestamp >= ..2026-07-20T10:00:00Z.. AND timestamp <= ..2026-07-21T10:00:00Z.*

# Contradictory bounds never reach the API: DuckDB's own optimizer folds them away before the scan
# is planned, so the extension is never asked for a request. (The scan additionally refuses to issue
# one if such bounds ever do reach it -- see GcloudFilterPushdown::empty_result.)
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p')
WHERE time_unix_nano >= TIMESTAMP_NS '2026-07-21 10:00:00'
  AND time_unix_nano <= TIMESTAMP_NS '2026-07-20 10:00:00';
----
physical_plan	<REGEX>:.*EMPTY_RESULT.*

# A value that is not a Cloud Logging LogSeverity member is never pushed.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p') WHERE severity_text = 'FATAL';
----
physical_plan	<!REGEX>:.*Google Cloud Filter.*

# service_name is derived by falling back across several API fields, so any single filter term
# would match strictly fewer rows than the SQL predicate. It must stay a local filter.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p') WHERE service_name = 'checkout';
----
physical_plan	<!REGEX>:.*Google Cloud Filter.*

# trace_id is excluded for the same reason: the mapping accepts both the
# "projects/P/traces/ID" form and a bare id.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p') WHERE trace_id = 'abc';
----
physical_plan	<!REGEX>:.*Google Cloud Filter.*

# An OR is not decomposed: pushing one branch alone would drop rows matching only the other.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p')
WHERE severity_text = 'ERROR' OR body = 'x';
----
physical_plan	<!REGEX>:.*Google Cloud Filter.*

# max_rows caps rows as they arrive from the API, before the SQL WHERE runs, so pushdown is
# disabled: otherwise the cap would apply to a different population than it does without it.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM read_gcloud_logs(project => 'p', max_rows => 1)
WHERE severity_text = 'ERROR';
----
physical_plan	<!REGEX>:.*Google Cloud Filter.*

# ---------------------------------------------------------------------------
# Catalog (ATTACH 'gcloud:')
# ---------------------------------------------------------------------------

statement ok
ATTACH 'gcloud:' AS gcp (TYPE gcloud, PROJECT 'my-project', START_TIME '-1h');

# One log table, two Cloud Monitoring alert tables, and one App Topology service-map table.
query II
SELECT table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'gcp'
ORDER BY table_schema, table_name;
----
alerts	open
alerts	policies
logs	entries
service_map	dependencies

# The catalog log table carries the same 18-column OTLP schema as the reader.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM gcp.logs.entries);
----
18

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM gcp.alerts.open);
----
17

# Existing columns remain in their original positions and the current v3 Alert metadata is exposed.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM gcp.alerts.open)
WHERE column_name IN ('incident_id', 'policy_id', 'policy_name', 'state', 'summary', 'resource_type',
                      'resource_labels', 'opened_at', 'closed_at', 'alert_name', 'policy_severity',
                      'policy_user_labels', 'resource_system_labels', 'resource_user_labels',
                      'metric_type', 'metric_labels', 'log_extracted_labels');
----
17

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM gcp.alerts.policies);
----
11

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM gcp.service_map.dependencies);
----
17

# Pushdown applies to catalog tables too, ANDed onto the attachment's own time bound.
query II
EXPLAIN (FORMAT JSON) SELECT body FROM gcp.logs.entries WHERE severity_text = 'ALERT';
----
physical_plan	<REGEX>:.*severity = ..ALERT.*

# Binding and planning an alert table is network-free; Cloud Monitoring is called only on scan.
query II
EXPLAIN (FORMAT JSON) SELECT incident_id, state FROM gcp.alerts.open;
----
physical_plan	<REGEX>:.*state=OPEN.*

# The catalog is read-only.
statement error
CREATE TABLE gcp.logs.new_table (a INTEGER);
----
read-only

statement error
DROP TABLE gcp.logs.entries;
----
read-only

statement ok
DETACH gcp;

# ATTACH reuses the reader's validator, so the two interfaces' rules cannot drift.
statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, BOGUS_OPTION 'x');
----
Unsupported gcloud ATTACH option

statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, ORDER_BY 'severity desc');
----
order_by must be 'timestamp desc' or 'timestamp asc'

statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, PAGE_SIZE 5000);
----
page_size must be between 1 and 1000

statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, MAX_ROWS -1);
----
max_rows must be >= 0

statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, TIMEOUT 0);
----
timeout must be >= 1

# Only the 'gcloud:' path is accepted.
statement error
ATTACH 'gcloud://something' AS bad (TYPE gcloud);
----
must be attached from the path 'gcloud:'

# A named secret that does not exist fails at attach time, not at first query.
statement error
ATTACH 'gcloud:' AS bad (TYPE gcloud, SECRET 'no_such_secret');
----
No secret with name 'no_such_secret' found
